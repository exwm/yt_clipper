#!/bin/bash
cd "$(dirname "$0")" || exit

read -rp "Enter the path of a markers JSON file (you can drag the file into this window): " JSON

read -rp "Enter the path of the input video: " INPUTVIDEO

# A dragged file's path has its special characters escaped and a trailing space; a pasted one is as
# typed (xargs would stop at its apostrophe).
cleanPath() {
  local path="${1%"${1##*[![:space:]]}"}"
  if [[ "$path" == *\\* ]]; then path="$(xargs <<<"$path")"; fi
  printf '%s' "$path"
}
JSON="$(cleanPath "$JSON")"
INPUTVIDEO="$(cleanPath "$INPUTVIDEO")"

OPTIONS=()

run() {
  ./yt_clipper --markers-json "$JSON" --input-video "$INPUTVIDEO" "${OPTIONS[@]}"
}

if [ -f "$JSON" ] && [ -f "$INPUTVIDEO" ]; then
  run
  while read -rp "Enter all the options for another run (for example --overwrite --audio), or press Enter to finish: " LINE && [ -n "$LINE" ]; do
    eval "OPTIONS=($LINE)" || { echo "[ERROR] Could not read those options. Check the quotes, and put quotes around a value with < > | & ; or ' in it."; continue; }
    run
  done
else
  echo "[ERROR] \"$JSON\" or \"$INPUTVIDEO\" does not exist."
fi

echo
echo "[INFO] You are in the yt_clipper folder. Run ./yt_clipper -h to list the options."
exec "${SHELL:-/bin/zsh}" -i
