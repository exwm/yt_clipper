#!/bin/bash
cd "$(dirname "$0")" || exit

prompt() {
  echo
  echo "[INFO] You are in the yt_clipper folder."
  exec "${SHELL:-/bin/zsh}" -i
}

read -rp "Enter the paths of 1 or more video files to convert to gif (you can drag files into this window): " VIDEOSPROMPT

IFS=$'\n' VIDEOS=($(xargs -n1 <<<"$VIDEOSPROMPT"))

NVIDEOS="${#VIDEOS[@]}"

if [ "$NVIDEOS" -lt 1 ]; then
  echo "[ERROR] Enter at least 1 video file."
  prompt
fi

VIDEO="${VIDEOS[0]}"

read -rp "Enter the gif frame rate (default 8): " FPS
read -rp "Enter the gif size: the longer side in pixels, or WxH (default 128): " SCALE

FPS="${FPS:-8}"
SCALE="${SCALE:-128}"

echo -e '\n'
echo "[INFO] Using frame rate $FPS and size $SCALE."
echo -e '\n'

# WxH with an x or an X; a size with one number (or a stray x) is the longer side.
IFS='xX' read -ra SCALES <<<"$SCALE"
if [[ -n "${SCALES[0]}" && -n "${SCALES[1]}" ]]; then
  SCALE_FILTER="${SCALES[0]}x${SCALES[1]}"
else
  SCALE="${SCALES[0]:-${SCALES[1]}}"
  SCALE_FILTER="'if(gte(iw,ih),$SCALE,-1):if(gte(iw,ih),-1,$SCALE)'"
fi

for VIDEO in "${VIDEOS[@]}"; do
  if [ -f "$VIDEO" ]; then
    DIR="$(dirname "$VIDEO")"
    NAME="${VIDEO##*/}"
    EXT=".${NAME##*.}"
    NAME="${NAME%.*}"
    OUT="$DIR/$NAME.gif"

    echo "[INFO] Generating $OUT..."

    ./bin/video-tools/ffmpeg -i "$VIDEO" -vf "fps=${FPS},scale=$SCALE_FILTER:flags=lanczos,setdar=ratio=a,hqdn3d,split[s0][s1];[s0]palettegen=stats_mode=diff[p];[s1][p]paletteuse" "$OUT"
  else
    echo "[ERROR] \"$VIDEO\" does not exist."
  fi
done

prompt
