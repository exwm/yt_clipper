#!/bin/bash
cd "$(dirname "$0")" || exit

prompt() {
  echo
  echo "[INFO] You are in the yt_clipper folder."
  exec "${SHELL:-/bin/zsh}" -i
}

echo "----------------------------------------------------"
echo "This script converts the stream of an HEVC (H.265) video to a form ffmpeg can read."
echo "The converted file name ends with -preproc."
echo "----------------------------------------------------"

read -rp "Enter the path of an HEVC video file (you can drag files into this window): " VIDEOSPROMPT

IFS=$'\n' VIDEOS=($(xargs -n1 <<<"$VIDEOSPROMPT"))

NVIDEOS="${#VIDEOS[@]}"

if [ "$NVIDEOS" -ne 1 ]; then
  echo "[ERROR] Enter one video file."
  prompt
fi

VIDEO="${VIDEOS[0]}"

DIR="$(dirname "$VIDEO")"
NAME="${VIDEO##*/}"
EXT=".${NAME##*.}"
NAME="${NAME%.*}"
OUT="$DIR/$NAME-preproc$EXT"

if [ -f "$VIDEO" ]; then
  echo "[INFO] Generating $OUT..."
  ./bin/video-tools/ffmpeg -i "$VIDEO" -c copy -bsf:v hevc_mp4toannexb "$OUT"
else
  echo "[ERROR] \"$VIDEO\" does not exist."
fi

echo "----------------------------------------------------"
echo "This script converts the stream of an HEVC (H.265) video to a form ffmpeg can read."
echo "The converted file name ends with -preproc."
echo "----------------------------------------------------"

prompt
