{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "yt_clipper markers JSON",
  "$comment": "The current format the markup script saves. Legacy shapes (`markers` for `markerPairs`, string speeds) are normalized before validation. The markup's allowlists in src/markup/save-load/parse-clipper-input.ts must list exactly these properties (checked by parse-clipper-input.schema.test.ts). The clipper drops unknown keys and validates the rest (src/clipper/markers_schema.py).",
  "type": "object",
  "required": ["videoID", "videoTitle", "cropRes", "cropResWidth", "cropResHeight", "markerPairs"],
  "additionalProperties": false,
  "properties": {
    "platform": {
      "enum": [
        "youtube",
        "vlive",
        "weverse",
        "naver_tv",
        "naver_now_watch",
        "afreecatv",
        "ytc_generic"
      ]
    },
    "videoID": {
      "type": "string",
      "description": "a video ID without spaces, quotes, or backslashes",
      "pattern": "^[^\\s\"'\\\\]+$(?![\\s\\S])"
    },
    "videoTag": { "type": "string" },
    "videoTitle": { "type": "string" },
    "videoUrl": {
      "type": "string",
      "description": "an http or https URL",
      "pattern": "^https?://[^\\s\"'\\\\]+$(?![\\s\\S])"
    },
    "newMarkerSpeed": { "$ref": "#/$defs/speed" },
    "newMarkerCrop": { "$ref": "#/$defs/crop" },
    "titleSuffix": { "type": "string" },
    "isVerticalVideo": { "type": "boolean" },
    "cropRes": { "$ref": "#/$defs/cropRes" },
    "cropResWidth": { "$ref": "#/$defs/positiveNumber" },
    "cropResHeight": { "$ref": "#/$defs/positiveNumber" },
    "markerPairMergeList": {
      "type": "string",
      "description": "marker pair numbers and ranges such as 1-3,5;2,4",
      "pattern": "^ *(\\d{1,2}(-\\d{1,2})?( *, *\\d{1,2}(-\\d{1,2})?)* *,? *)?(; *\\d{1,2}(-\\d{1,2})?( *, *\\d{1,2}(-\\d{1,2})?)* *,? *)*$(?![\\s\\S])"
    },
    "encodeSpeed": { "type": "number" },
    "crf": { "type": "number" },
    "targetMaxBitrate": { "type": "number" },
    "rotate": { "enum": ["0", "clock", "cclock"] },
    "enableHDR": { "type": "boolean" },
    "gamma": { "$ref": "#/$defs/positiveNumber" },
    "twoPass": { "type": "boolean" },
    "denoise": { "$ref": "#/$defs/denoise" },
    "audio": { "type": "boolean" },
    "videoStabilization": { "$ref": "#/$defs/videoStabilization" },
    "videoStabilizationDynamicZoom": { "type": "boolean" },
    "minterpFpsMultiplier": { "type": "number", "minimum": 0 },
    "loop": { "$ref": "#/$defs/loop" },
    "fadeDuration": { "type": "number", "minimum": 0 },
    "cropPointEasing": { "$ref": "#/$defs/cropPointEasing" },
    "cropPointEasingCinematicMargin": { "type": "number", "minimum": 0, "maximum": 50 },
    "cropPointEasingCinematicZoomMargin": { "type": "number", "minimum": 0, "maximum": 100 },
    "cropPointEasingCinematicHolds": { "enum": ["loose", "firm", "exact"] },
    "version": { "type": "string" },
    "date": { "type": "number" },
    "cropPointEasingCinematicSolverVersion": {
      "type": "integer",
      "minimum": 1,
      "description": "the version of the Cinematic crop easing solver the preview used"
    },
    "markerPairs": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/markerPair" } }
  },
  "$defs": {
    "positiveNumber": { "type": "number", "exclusiveMinimum": 0 },
    "speed": { "type": "number", "exclusiveMinimum": 0 },
    "crop": {
      "type": "string",
      "description": "a crop as x:y:w:h in pixels, with a width and height of at least 1 (w may be iw, h may be ih)",
      "pattern": "^\\d+(\\.\\d+)?:\\d+(\\.\\d+)?:(0*[1-9]\\d*(\\.\\d+)?|iw):(0*[1-9]\\d*(\\.\\d+)?|ih)$(?![\\s\\S])"
    },
    "cropRes": {
      "type": "string",
      "description": "a resolution such as 1920x1080",
      "pattern": "^[1-9]\\d*x[1-9]\\d*$(?![\\s\\S])"
    },
    "loop": { "enum": ["none", "fwrev", "fade"] },
    "cropPointEasing": { "enum": ["smoothInOut", "smoothTrack", "cinematic"] },
    "denoise": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "desc": { "type": "string" },
        "lumaSpatial": { "type": "number", "minimum": 0 }
      }
    },
    "videoStabilization": {
      "type": "object",
      "required": ["enabled"],
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "desc": { "type": "string" },
        "shakiness": { "type": "number", "minimum": 0 },
        "smoothing": { "type": "number", "minimum": 0 },
        "zoomspeed": { "type": "number", "minimum": 0 }
      }
    },
    "speedPoint": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "$ref": "#/$defs/speed" }
      }
    },
    "cropPoint": {
      "type": "object",
      "required": ["x", "y", "crop"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "const": 0 },
        "crop": { "$ref": "#/$defs/crop" },
        "easeIn": { "const": "instant" },
        "hold": { "const": true }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "titlePrefix": { "type": "string" },
        "enableHDR": { "type": "boolean" },
        "gamma": { "$ref": "#/$defs/positiveNumber" },
        "encodeSpeed": { "type": "number" },
        "crf": { "type": "number" },
        "targetMaxBitrate": { "type": "number" },
        "twoPass": { "type": "boolean" },
        "denoise": { "$ref": "#/$defs/denoise" },
        "audio": { "type": "boolean" },
        "videoStabilization": { "$ref": "#/$defs/videoStabilization" },
        "videoStabilizationDynamicZoom": { "type": "boolean" },
        "minterpFpsMultiplier": { "type": "number", "minimum": 0 },
        "loop": { "$ref": "#/$defs/loop" },
        "fadeDuration": { "type": "number", "minimum": 0 },
        "cropPointEasing": { "$ref": "#/$defs/cropPointEasing" },
        "cropPointEasingCinematicMargin": { "type": "number", "minimum": 0, "maximum": 50 },
        "cropPointEasingCinematicZoomMargin": { "type": "number", "minimum": 0, "maximum": 100 },
        "cropPointEasingCinematicHolds": { "enum": ["loose", "firm", "exact"] }
      }
    },
    "markerPair": {
      "type": "object",
      "required": ["start", "end", "speed", "crop", "cropRes", "overrides"],
      "additionalProperties": false,
      "properties": {
        "number": { "type": "integer", "minimum": 1 },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "speed": { "$ref": "#/$defs/speed" },
        "speedMap": { "type": "array", "items": { "$ref": "#/$defs/speedPoint" } },
        "crop": { "$ref": "#/$defs/crop" },
        "cropMap": { "type": "array", "items": { "$ref": "#/$defs/cropPoint" } },
        "enableZoomPan": { "type": "boolean" },
        "cropRes": { "$ref": "#/$defs/cropRes" },
        "overrides": { "$ref": "#/$defs/overrides" }
      }
    }
  }
}
